<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Optimize.App.ViewModels"
             xmlns:conv="using:Optimize.App.Converters"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Optimize.App.Views.ImpressorasView"
             x:DataType="vm:ImpressorasViewModel">

    <ScrollViewer>
        <StackPanel Spacing="20" MaxWidth="1080" HorizontalAlignment="Stretch">

            <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                    CornerRadius="4" Padding="10,8"
                    IsVisible="{Binding MensagemDeErro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding MensagemDeErro}" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                            <TextBlock Text="Máquinas agora" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" FontSize="13" Opacity="0.65"
                                       Text="Atualiza sozinho quando alguma máquina imprime algo novo ou muda de status." />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Atualizar" Command="{Binding CarregarCommand}"
                                Padding="14,8" CornerRadius="4" VerticalAlignment="Top" />
                    </Grid>

                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding Carregando}" />

                    <StackPanel IsVisible="{Binding !TemImpressoras}" HorizontalAlignment="Center" Spacing="10" Margin="0,24">
                        <ui:SymbolIcon Symbol="Print" FontSize="30" Opacity="0.4" HorizontalAlignment="Center" />
                        <TextBlock Text="Nenhuma máquina cadastrada ainda" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Opacity="0.6"
                                   MaxWidth="360" HorizontalAlignment="Center"
                                   Text="Vá em Máquinas e rode a varredura de rede pra encontrar as impressoras da fábrica." />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Impressoras}" IsVisible="{Binding TemImpressoras}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImpressoraCardItem">
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="16" Margin="0,0,10,10" Width="260">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <ui:SymbolIcon Grid.Column="0" Symbol="Print"
                                                           Foreground="{DynamicResource SystemAccentColor}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding RotuloDoTipo}" FontSize="11" Opacity="0.6" />
                                            </StackPanel>
                                            <Ellipse Grid.Column="2" Width="10" Height="10" VerticalAlignment="Center"
                                                     Fill="{Binding Online, Converter={x:Static conv:StatusOnlineParaCorConverter.Instancia}}"
                                                     ToolTip.Tip="{Binding Online}" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Grid.Column="0" Spacing="1">
                                                <TextBlock Text="Trabalhos hoje" FontSize="10.5" Opacity="0.55" />
                                                <TextBlock Text="{Binding TrabalhosHoje}" FontSize="15" FontWeight="SemiBold" FontFamily="{DynamicResource FonteMono}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="Metragem hoje" FontSize="10.5" Opacity="0.55" />
                                                <TextBlock Text="{Binding MetragemHoje}" FontSize="15" FontWeight="SemiBold" FontFamily="{DynamicResource FonteMono}" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="1" IsVisible="{Binding UltimoTrabalho, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="Último trabalho" FontSize="10.5" Opacity="0.55" />
                                            <TextBlock Text="{Binding UltimoTrabalho}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding UltimoTrabalho}" />
                                            <TextBlock Text="{Binding UltimoHorario}" FontSize="11" Opacity="0.6" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
