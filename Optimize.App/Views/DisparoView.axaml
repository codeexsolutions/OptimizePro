<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Optimize.App.ViewModels"
             xmlns:controls="using:Optimize.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Optimize.App.Views.DisparoView"
             x:DataType="vm:DisparoViewModel">
    <controls:PlaceholderDeTela Icone="Send" Titulo="Disparo"
        Descricao="Em stand-by: vai virar captação de lead, enviando dados pra uma base separada (Supabase) via notificação silenciosa — origem do lead ainda não definida." />
</UserControl>
