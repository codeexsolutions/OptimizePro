<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Optimize.App.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
        x:Class="Optimize.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/optimize.ico"
        Title="Optimize Pro"
        Background="{DynamicResource PincelFundo}"
        FontFamily="{DynamicResource FonteTexto}"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600">

    <!-- DataContext real é resolvido via DI em App.axaml.cs (MainWindowViewModel exige
         IFabricaDeViewModels no construtor, por isso não há Design.DataContext aqui). -->

    <ui:NavigationView x:Name="NavPrincipal"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="False"
                        OpenPaneLength="244"
                        SelectionChanged="NavPrincipal_OnSelectionChanged">

        <!-- Seções (PRODUÇÃO/DESIGN/IMPRESSÃO/RELATÓRIOS/...) alinhadas com a sidebar do
             optmize-full (12/09/2026, pedido do usuário depois de comparar as duas telas lado a
             lado) — antes era uma lista só, sem cabeçalho de seção nenhum. O selo/marca saiu
             daqui e foi pro rodapé (PaneFooter), mesmo lugar que a referência usa. -->
        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItemHeader Content="PRODUÇÃO" />
            <ui:NavigationViewItem Tag="Moldes" IsSelected="True" AutomationProperties.Name="Moldes">
                <ui:NavigationViewItem.IconSource>
                    <ui:SymbolIconSource Symbol="Cut" />
                </ui:NavigationViewItem.IconSource>
                <ui:NavigationViewItem.Content>
                    <StackPanel Spacing="0" VerticalAlignment="Center" Margin="0,2">
                        <TextBlock Text="Moldes" FontSize="13" LineHeight="16" />
                        <TextBlock Text="Modelagem da produção" FontSize="11" Opacity="0.6" LineHeight="14" />
                    </StackPanel>
                </ui:NavigationViewItem.Content>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Tag="Projetos" AutomationProperties.Name="Projetos">
                <ui:NavigationViewItem.IconSource>
                    <ui:SymbolIconSource Symbol="Folder" />
                </ui:NavigationViewItem.IconSource>
                <ui:NavigationViewItem.Content>
                    <StackPanel Spacing="0" VerticalAlignment="Center" Margin="0,2">
                        <TextBlock Text="Projetos" FontSize="13" LineHeight="16" />
                        <TextBlock Text="Trabalho que se repete" FontSize="11" Opacity="0.6" LineHeight="14" />
                    </StackPanel>
                </ui:NavigationViewItem.Content>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Tag="Encaixe" AutomationProperties.Name="Encaixe">
                <ui:NavigationViewItem.IconSource>
                    <ui:SymbolIconSource Symbol="ViewAll" />
                </ui:NavigationViewItem.IconSource>
                <ui:NavigationViewItem.Content>
                    <StackPanel Spacing="0" VerticalAlignment="Center" Margin="0,2">
                        <TextBlock Text="Encaixe" FontSize="13" LineHeight="16" />
                        <TextBlock Text="Aproveitamento do tecido" FontSize="11" Opacity="0.6" LineHeight="14" />
                    </StackPanel>
                </ui:NavigationViewItem.Content>
            </ui:NavigationViewItem>
            <ui:NavigationViewItemHeader Content="DESIGN" />
            <ui:NavigationViewItem Tag="Vetor" AutomationProperties.Name="Vetor">
                <ui:NavigationViewItem.IconSource>
                    <ui:SymbolIconSource Symbol="ImageEdit" />
                </ui:NavigationViewItem.IconSource>
                <ui:NavigationViewItem.Content>
                    <StackPanel Spacing="0" VerticalAlignment="Center" Margin="0,2">
                        <TextBlock Text="Vetor" FontSize="13" LineHeight="16" />
                        <TextBlock Text="Traço a partir da imagem" FontSize="11" Opacity="0.6" LineHeight="14" />
                    </StackPanel>
                </ui:NavigationViewItem.Content>
            </ui:NavigationViewItem>

            <ui:NavigationViewItemHeader Content="IMPRESSÃO" />
            <ui:NavigationViewItem Tag="Impressoras" AutomationProperties.Name="Impressoras" IsVisible="{Binding PodeVerImpressoras}">
                <ui:NavigationViewItem.IconSource>
                    <ui:SymbolIconSource Symbol="Print" />
                </ui:NavigationViewItem.IconSource>
                <ui:NavigationViewItem.Content>
                    <StackPanel Spacing="0" VerticalAlignment="Center" Margin="0,2">
                        <TextBlock Text="Impressoras" FontSize="13" LineHeight="16" />
                        <TextBlock Text="Painel ao vivo" FontSize="11" Opacity="0.6" LineHeight="14" />
                    </StackPanel>
                </ui:NavigationViewItem.Content>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Tag="Maquinas" AutomationProperties.Name="Máquinas" IsVisible="{Binding PodeVerMaquinas}">
                <ui:NavigationViewItem.IconSource>
                    <ui:SymbolIconSource Symbol="Print" />
                </ui:NavigationViewItem.IconSource>
                <ui:NavigationViewItem.Content>
                    <StackPanel Spacing="0" VerticalAlignment="Center" Margin="0,2">
                        <TextBlock Text="Máquinas" FontSize="13" LineHeight="16" />
                        <TextBlock Text="Frota de impressoras" FontSize="11" Opacity="0.6" LineHeight="14" />
                    </StackPanel>
                </ui:NavigationViewItem.Content>
            </ui:NavigationViewItem>
            <ui:NavigationViewItemHeader Content="RELATÓRIOS" />
            <ui:NavigationViewItem Tag="Historico" AutomationProperties.Name="Histórico" IsVisible="{Binding PodeVerHistorico}">
                <ui:NavigationViewItem.IconSource>
                    <ui:SymbolIconSource Symbol="Document" />
                </ui:NavigationViewItem.IconSource>
                <ui:NavigationViewItem.Content>
                    <StackPanel Spacing="0" VerticalAlignment="Center" Margin="0,2">
                        <TextBlock Text="Histórico" FontSize="13" LineHeight="16" />
                        <TextBlock Text="Trabalhos que saíram das máquinas" FontSize="11" Opacity="0.6" LineHeight="14" />
                    </StackPanel>
                </ui:NavigationViewItem.Content>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Tag="Reposicao" AutomationProperties.Name="Reposição" IsVisible="{Binding PodeVerReposicao}">
                <ui:NavigationViewItem.IconSource>
                    <ui:SymbolIconSource Symbol="Refresh" />
                </ui:NavigationViewItem.IconSource>
                <ui:NavigationViewItem.Content>
                    <StackPanel Spacing="0" VerticalAlignment="Center" Margin="0,2">
                        <TextBlock Text="Reposição" FontSize="13" LineHeight="16" />
                        <TextBlock Text="Trabalho refeito, por semana" FontSize="11" Opacity="0.6" LineHeight="14" />
                    </StackPanel>
                </ui:NavigationViewItem.Content>
            </ui:NavigationViewItem>
            <ui:NavigationViewItemHeader Content="FILA" />
            <ui:NavigationViewItem Tag="Pedidos" AutomationProperties.Name="Pedidos" IsVisible="{Binding PodeVerPedidos}">
                <ui:NavigationViewItem.IconSource>
                    <ui:SymbolIconSource Symbol="List" />
                </ui:NavigationViewItem.IconSource>
                <ui:NavigationViewItem.Content>
                    <StackPanel Spacing="0" VerticalAlignment="Center" Margin="0,2">
                        <TextBlock Text="Pedidos" FontSize="13" LineHeight="16" />
                        <TextBlock Text="A fila da calandra" FontSize="11" Opacity="0.6" LineHeight="14" />
                    </StackPanel>
                </ui:NavigationViewItem.Content>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Tag="OrdensDeServico" AutomationProperties.Name="Ordens de Serviço" IsVisible="{Binding PodeVerOrdensDeServico}">
                <ui:NavigationViewItem.IconSource>
                    <ui:SymbolIconSource Symbol="Document" />
                </ui:NavigationViewItem.IconSource>
                <ui:NavigationViewItem.Content>
                    <StackPanel Spacing="0" VerticalAlignment="Center" Margin="0,2">
                        <TextBlock Text="Ordens de Serviço" FontSize="13" LineHeight="16" />
                        <TextBlock Text="Referência de imagem por cliente" FontSize="11" Opacity="0.6" LineHeight="14" />
                    </StackPanel>
                </ui:NavigationViewItem.Content>
            </ui:NavigationViewItem>
            <ui:NavigationViewItemHeader Content="COMUNICAÇÃO" />
            <ui:NavigationViewItem Tag="Disparo" AutomationProperties.Name="Disparo">
                <ui:NavigationViewItem.IconSource>
                    <ui:SymbolIconSource Symbol="Send" />
                </ui:NavigationViewItem.IconSource>
                <ui:NavigationViewItem.Content>
                    <StackPanel Spacing="0" VerticalAlignment="Center" Margin="0,2">
                        <TextBlock Text="Disparo" FontSize="13" LineHeight="16" />
                        <TextBlock Text="Captação de lead (em stand-by)" FontSize="11" Opacity="0.6" LineHeight="14" />
                    </StackPanel>
                </ui:NavigationViewItem.Content>
            </ui:NavigationViewItem>
            <ui:NavigationViewItemHeader Content="SISTEMA" />
            <ui:NavigationViewItem Tag="Configuracoes" AutomationProperties.Name="Configurações">
                <ui:NavigationViewItem.IconSource>
                    <ui:SymbolIconSource Symbol="Settings" />
                </ui:NavigationViewItem.IconSource>
                <ui:NavigationViewItem.Content>
                    <StackPanel Spacing="0" VerticalAlignment="Center" Margin="0,2">
                        <TextBlock Text="Configurações" FontSize="13" LineHeight="16" />
                        <TextBlock Text="Preferências do app" FontSize="11" Opacity="0.6" LineHeight="14" />
                    </StackPanel>
                </ui:NavigationViewItem.Content>
            </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>

        <ui:NavigationView.PaneFooter>
            <StackPanel Margin="16,0,16,16" Spacing="8">
                <!-- Gate de módulos (§25) — só aparece pra quem realmente logou; sem sessão de
                     painel (instalação que nunca configurou usuário), não tem "sair" nem sentido. -->
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding PodeSair}">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource PincelSucesso}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding NomeDoUsuarioLogado}" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource PincelTinta}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding PodeSair}">
                    <Button Grid.Column="0" Content="Sincronizar" Command="{Binding SincronizarCommand}" IsEnabled="{Binding !Sincronizando}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Margin="0,0,8,0" Padding="0,7" CornerRadius="6" FontSize="12" />
                    <Button Grid.Column="1" Content="Sair" Command="{Binding SairCommand}"
                            Padding="12,7" CornerRadius="6" FontSize="12" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource PincelAmbar}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusWhatsApp, StringFormat='WhatsApp: {0}'}"
                               FontSize="12" Foreground="{DynamicResource PincelTintaFraca}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Selo + nome no rodapé, não mais no topo (12/09/2026, pra bater com a
                     posição da marca na sidebar do optmize-full). Logo oficial (12/09/2026,
                     fornecida pelo usuário) — fundo branco próprio da arte, só recortada em
                     cantos arredondados pro mesmo tamanho de crachá que o "OP" ocupava. -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Border Width="26" Height="26" CornerRadius="8" ClipToBounds="True"
                            BorderBrush="{DynamicResource PincelAmbarLinha}" BorderThickness="1">
                        <Image Source="/Assets/optimize-logo.png" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="Optimize Pro" FontSize="12.5" FontWeight="Bold" LetterSpacing="0.1"
                                   Foreground="{DynamicResource PincelTinta}" LineHeight="15" />
                        <TextBlock Text="Moldes &amp; encaixe" FontSize="9.7" LetterSpacing="0.2"
                                   Foreground="{DynamicResource PincelTintaApagada}" LineHeight="12" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding VersaoDoApp}" FontSize="10.5"
                           Foreground="{DynamicResource PincelTintaApagada}" HorizontalAlignment="Center" />
            </StackPanel>
        </ui:NavigationView.PaneFooter>

        <ui:NavigationView.Content>
            <Grid RowDefinitions="Auto,*" Background="{DynamicResource PincelFundo}">

                <!-- Cabeçalho fixo — porte de Cabecalho.tsx: selo da tela, título, apoio e relógio. -->
                <Border Grid.Row="0"
                        Background="{DynamicResource PincelTopo}"
                        BorderBrush="{DynamicResource PincelLinha}" BorderThickness="0,0,0,1"
                        Padding="30,11">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                Background="{DynamicResource PincelAmbarSuave}"
                                BorderBrush="{DynamicResource PincelAmbarLinha}" BorderThickness="1"
                                Margin="0,0,14,0">
                            <ui:SymbolIcon Symbol="{Binding InfoDaTelaAtual.Icone}" FontSize="17"
                                           Foreground="{DynamicResource PincelAmbar}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding InfoDaTelaAtual.Titulo}"
                                       FontFamily="{DynamicResource FonteTitulo}" FontSize="19" FontWeight="SemiBold"
                                       LetterSpacing="-0.4"
                                       Foreground="{DynamicResource PincelTinta}" VerticalAlignment="Center" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource PincelAmbarLinha}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding InfoDaTelaAtual.ApoioTopo}" FontSize="12.5"
                                       Foreground="{DynamicResource PincelTintaFraca}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Border Grid.Column="2" Background="{DynamicResource PincelPainel}"
                                BorderBrush="{DynamicResource PincelLinha}" BorderThickness="1" CornerRadius="9"
                                Padding="11,7">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <ui:SymbolIcon Symbol="Clock" FontSize="13" Foreground="{DynamicResource PincelAmbar}" />
                                <TextBlock Text="{Binding RelogioData}" FontSize="11"
                                           Foreground="{DynamicResource PincelTintaFraca}" VerticalAlignment="Center" />
                                <Rectangle Width="1" Height="13" Fill="{DynamicResource PincelLinha}" />
                                <TextBlock Text="{Binding RelogioHora}" FontFamily="{DynamicResource FonteMono}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PincelTinta}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding TelaAtual}" Margin="30,24" />
            </Grid>
        </ui:NavigationView.Content>

    </ui:NavigationView>

</Window>
