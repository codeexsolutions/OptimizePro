<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styling="using:FluentAvalonia.Styling"
             x:Class="Optimize.App.App"
             xmlns:local="using:Optimize.App"
             RequestedThemeVariant="Dark">
             <!-- Âmbar sobre preto, num tema só (mesma decisão do optmize-full — ver
                  estilo/tokens.css lá) — não segue o tema do sistema de propósito. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!--
                ===================================================================
                TOKENS — mesma paleta/tipografia do optmize-full (estilo/tokens.css),
                pra "montar o mesmo modelo" em .NET. Único lugar do app onde um hex
                devia precisar aparecer — tela nova usa DynamicResource daqui.
                ===================================================================
            -->

            <!-- Âmbar da marca — dobra também como SystemAccentColor do FluentAvalonia. -->
            <Color x:Key="SystemAccentColor">#F97316</Color>
            <Color x:Key="SystemAccentColorLight1">#FFA04D</Color>
            <Color x:Key="SystemAccentColorLight2">#FFB670</Color>
            <Color x:Key="SystemAccentColorLight3">#FFCC99</Color>
            <Color x:Key="SystemAccentColorDark1">#EA6A0A</Color>
            <Color x:Key="SystemAccentColorDark2">#C7590A</Color>
            <Color x:Key="SystemAccentColorDark3">#9C4708</Color>

            <!-- Fundos, do mais fundo pro mais próximo do olho (bg .. surface-hover no CSS de referência). -->
            <Color x:Key="CorFundo">#0B0B0C</Color>
            <Color x:Key="CorFundoMenu">#0E0E10</Color>
            <Color x:Key="CorPainel">#141416</Color>
            <Color x:Key="CorPainelSuave">#1A1A1D</Color>
            <Color x:Key="CorSuperficieHover">#1E1E22</Color>
            <Color x:Key="CorTopo">#EB0B0B0C</Color>

            <Color x:Key="CorLinha">#2A2A2F</Color>
            <Color x:Key="CorLinhaSuave">#202024</Color>

            <!-- Texto — os três níveis passam em contraste AA sobre CorFundo. -->
            <Color x:Key="CorTinta">#F4F2EF</Color>
            <Color x:Key="CorTintaFraca">#A09A93</Color>
            <Color x:Key="CorTintaApagada">#857E76</Color>

            <!-- Âmbar — variações + a cor de texto EM CIMA do âmbar (preto-queimado, não branco). -->
            <Color x:Key="CorAmbar">#F97316</Color>
            <Color x:Key="CorAmbarClaro">#FFA04D</Color>
            <Color x:Key="CorAmbarEscuro">#EA6A0A</Color>
            <Color x:Key="CorAmbarSuave">#1FF97316</Color>
            <Color x:Key="CorAmbarLinha">#4CF97316</Color>
            <Color x:Key="CorAmbarTinta">#180C02</Color>

            <Color x:Key="CorPerigo">#F26D6D</Color>
            <Color x:Key="CorPerigoEscuro">#D44949</Color>
            <Color x:Key="CorAviso">#F5B740</Color>
            <Color x:Key="CorSucesso">#4ED18A</Color>

            <!-- Brushes — o que as views de fato usam (DynamicResource, não Color direto). -->
            <SolidColorBrush x:Key="PincelFundo" Color="{StaticResource CorFundo}" />
            <SolidColorBrush x:Key="PincelFundoMenu" Color="{StaticResource CorFundoMenu}" />
            <SolidColorBrush x:Key="PincelPainel" Color="{StaticResource CorPainel}" />
            <SolidColorBrush x:Key="PincelPainelSuave" Color="{StaticResource CorPainelSuave}" />
            <SolidColorBrush x:Key="PincelSuperficieHover" Color="{StaticResource CorSuperficieHover}" />
            <SolidColorBrush x:Key="PincelTopo" Color="{StaticResource CorTopo}" />
            <SolidColorBrush x:Key="PincelLinha" Color="{StaticResource CorLinha}" />
            <SolidColorBrush x:Key="PincelLinhaSuave" Color="{StaticResource CorLinhaSuave}" />
            <SolidColorBrush x:Key="PincelTinta" Color="{StaticResource CorTinta}" />
            <SolidColorBrush x:Key="PincelTintaFraca" Color="{StaticResource CorTintaFraca}" />
            <SolidColorBrush x:Key="PincelTintaApagada" Color="{StaticResource CorTintaApagada}" />
            <SolidColorBrush x:Key="PincelAmbar" Color="{StaticResource CorAmbar}" />
            <SolidColorBrush x:Key="PincelAmbarClaro" Color="{StaticResource CorAmbarClaro}" />
            <SolidColorBrush x:Key="PincelAmbarEscuro" Color="{StaticResource CorAmbarEscuro}" />
            <SolidColorBrush x:Key="PincelAmbarSuave" Color="{StaticResource CorAmbarSuave}" />
            <SolidColorBrush x:Key="PincelAmbarLinha" Color="{StaticResource CorAmbarLinha}" />
            <SolidColorBrush x:Key="PincelAmbarTinta" Color="{StaticResource CorAmbarTinta}" />
            <SolidColorBrush x:Key="PincelPerigo" Color="{StaticResource CorPerigo}" />
            <SolidColorBrush x:Key="PincelAviso" Color="{StaticResource CorAviso}" />
            <SolidColorBrush x:Key="PincelSucesso" Color="{StaticResource CorSucesso}" />

            <!-- Tipografia — Space Grotesk (título), Inter (texto, já embutida via
                 Avalonia.Fonts.Inter), IBM Plex Mono (dado/relógio/rótulo técnico).
                 Fallback pro sistema se por algum motivo o arquivo embutido não carregar. -->
            <FontFamily x:Key="FonteTitulo">avares://Optimize.App/Assets/Fonts/SpaceGrotesk[wght].ttf#Space Grotesk,Segoe UI</FontFamily>
            <FontFamily x:Key="FonteTexto">Inter,Segoe UI</FontFamily>
            <FontFamily x:Key="FonteMono">avares://Optimize.App/Assets/Fonts/IBMPlexMono-Regular.ttf#IBM Plex Mono,Consolas</FontFamily>

            <x:Double x:Key="RaioDePainel">12</x:Double>
            <x:Double x:Key="RaioDePainelPequeno">9</x:Double>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <styling:FluentAvaloniaTheme />
    </Application.Styles>
</Application>
