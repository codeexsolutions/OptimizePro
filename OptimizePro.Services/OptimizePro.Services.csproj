<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- System.Drawing.Common (Vetor\DecodificacaoDeImagem) só roda no Windows — igual o
         resto do app (WinExe). Sem bumpar pra "net10.0-windows" pra não quebrar os projetos
         que referenciam este (net10.0 simples não pode referenciar um alvo -windows). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OptimizePro.Data\OptimizePro.Data.csproj" />
    <ProjectReference Include="..\OptimizePro.Core\OptimizePro.Core.csproj" />
    <ProjectReference Include="..\OptimizePro.Licenciamento\OptimizePro.Licenciamento.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
    <!-- DPAPI (LicencaService) — só Windows, igual o resto do app (WinExe); CA1416 já suprimido acima. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!-- Exportação de Vetor pra PDF (§20, "Salvar como") — MIT, sem conflito de licença. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- QR da folha de pedido (§22.8) — a referência escreveu o encoder à mão só pra não
         rodar "npm install" de novo (motivo específico do Node); em .NET já puxamos pacotes
         livremente, então uma lib madura (MIT) vale mais que reimplementar ISO/IEC 18004. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Só pro validador de sobreposição do NFP (§7 do guia de melhorias) ter teste direto,
         não só indireto via EncaixeService — segurança demais em jogo (peça sobreposta =
         corte errado de verdade) pra confiar só em cobertura indireta. -->
    <InternalsVisibleTo Include="OptimizePro.Services.Tests" />
  </ItemGroup>

</Project>
